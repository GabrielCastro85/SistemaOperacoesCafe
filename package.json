{
  "name": "sistema-operacoes-cafe",
  "version": "0.13.0",
  "private": true,
  "description": "Aplicativo desktop offline-first para gerenciamento de operacoes de empresas do ramo de cafe.",
  "author": "Sistema Operacoes Cafe",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "main": "dist-electron/electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "npm run stop:electron && npm run build && npm run rebuild:electron && electron .",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest",
    "test:run": "vitest run",
    "generate:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/generate-icons.ps1",
    "package": "npm run package:multiempresa",
    "package:villa": "node scripts/release/package-variant.mjs villa --dir",
    "package:grao": "node scripts/release/package-variant.mjs grao --dir",
    "package:multiempresa": "node scripts/release/package-variant.mjs multiempresa --dir",
    "dist:villa": "node scripts/release/package-variant.mjs villa --installer",
    "dist:grao": "node scripts/release/package-variant.mjs grao --installer",
    "dist:multiempresa": "node scripts/release/package-variant.mjs multiempresa --installer",
    "release:villa": "npm run dist:villa",
    "release:grao": "npm run dist:grao",
    "release:multiempresa": "npm run dist:multiempresa",
    "release:all": "npm run release:villa && npm run release:grao && npm run release:multiempresa",
    "release:verify": "node scripts/release/verify-release.mjs",
    "smoke:packaged": "node scripts/release/smoke-packaged.mjs",
    "postpackage": "npm rebuild better-sqlite3",
    "stop:electron": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*SistemaOperacoesCafe*' -and (($_.Name -eq 'electron.exe') -or ($_.Name -eq 'node.exe' -and $_.CommandLine -like '*electron*')) } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pretest": "npm run rebuild:node",
    "pretest:run": "npm run rebuild:node"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "electron-log": "^5.2.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "br.com.operacoescafe.multiempresa",
    "productName": "Sistema de Operacoes de Cafe",
    "executableName": "SistemaOperacoesCafe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/multiempresa.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Operacoes de Cafe",
      "uninstallDisplayName": "Sistema de Operacoes de Cafe",
      "deleteAppDataOnUninstall": false,
      "language": "1046"
    }
  }
}
